---
const title = 'AI en el trabajo · Cursos de IA para personas';
const description = 'Cursos prácticos de inteligencia artificial en español: instrucciones, asistentes propios, agentes y automatización.';
const base = import.meta.env.BASE_URL;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}og-image.png`, Astro.site).href : `${base}og-image.png`;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{canonical && <link rel="canonical" href={canonical} />}
		<link rel="icon" href={`${base}favicon.ico`} sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
		<link rel="manifest" href={`${base}site.webmanifest`} />
		<meta name="theme-color" content="#5b2ee6" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content="AI en el trabajo" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="AI en el trabajo · Cursos de inteligencia artificial para personas" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<h1>AI en el trabajo</h1>
	</body>
</html>
