---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Hero from '../components/sections/Hero.astro';
import ToolsMarquee from '../components/sections/ToolsMarquee.astro';
import Backing from '../components/sections/Backing.astro';
import Shifts from '../components/sections/Shifts.astro';
import CourseCatalog from '../components/sections/CourseCatalog.astro';
import FreeTalk from '../components/sections/FreeTalk.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Faq from '../components/sections/Faq.astro';
import Waitlist from '../components/sections/Waitlist.astro';
import { homeStructuredData } from '../data/structuredData';
---

<BaseLayout>
	<JsonLd slot="head" data={homeStructuredData(Astro.site)} />
	<Hero />
	<ToolsMarquee />
	<Backing />
	<Shifts />
	<CourseCatalog />
	<FreeTalk />
	<HowItWorks />
	<Faq />
	<Waitlist />
</BaseLayout>
