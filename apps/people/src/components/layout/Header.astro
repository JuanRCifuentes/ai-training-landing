---
import Logo from './Logo.astro';
import Button from '../ui/Button.astro';
import { nav, waitlistCta } from '../../config/site';
import { routes } from '../../config/routes';
---

<header class="header" transition:persist>
	<div class="container inner">
		<Logo />
		<nav aria-label="Principal">
			<ul>
				{
					nav.map((item) => (
						<li>
							<a href={routes.section(item.section)}>{item.label}</a>
						</li>
					))
				}
			</ul>
		</nav>
		<Button class="cta" href={waitlistCta.href} variant="primary" size="sm">{waitlistCta.label}</Button>
	</div>
</header>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 5;
		border-bottom: 1px solid var(--line);
		background: color-mix(in srgb, var(--bg) 88%, transparent);
		backdrop-filter: blur(10px);
	}

	.inner {
		display: flex;
		align-items: center;
		gap: 24px;
		min-height: var(--header-height);
	}

	nav {
		margin-left: auto;
	}

	ul {
		display: flex;
		gap: 22px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	a {
		color: var(--ink-2);
		font-size: 15px;
		font-weight: 500;
		text-decoration: none;
	}

	a:hover {
		color: var(--accent);
	}

	/* On narrow screens the page itself is the navigation; only the call to action stays. */
	@media (max-width: 820px) {
		nav {
			display: none;
		}

		.inner :global(.cta) {
			margin-left: auto;
		}
	}

	@media (max-width: 440px) {
		.inner :global(.cta) {
			display: none;
		}
	}
</style>
