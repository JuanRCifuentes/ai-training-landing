---
import { site } from '../../config/site';
import { routes } from '../../config/routes';
import { markCells, markCursor } from '../../config/brand';
---

<a class="logo" href={routes.home}>
	<svg class="mark" viewBox="0 0 48 48" aria-hidden="true">
		{markCells.map(([x, y]) => <rect x={x} y={y} width="6" height="6" rx="1.5" class="cell" />)}
		<rect {...markCursor} rx="2" class="cursor" />
	</svg>
	<span class="name">{site.name}</span>
	<span class="audience">personas</span>
</a>

<style>
	.logo {
		display: flex;
		align-items: center;
		gap: 10px;
		color: var(--ink);
		font-weight: 700;
		letter-spacing: -0.02em;
		white-space: nowrap;
		text-decoration: none;
	}

	.mark {
		width: 32px;
		height: 32px;
		flex: none;
	}

	.cell {
		fill: var(--accent);
	}

	.cursor {
		fill: var(--pop);
	}

	.audience {
		padding: 2px 8px;
		border-radius: 999px;
		background: var(--pop);
		color: var(--on-pop);
		font: 500 12px var(--mono);
		letter-spacing: 0;
	}
</style>
