---
import type { Profession } from '../../data/professions';
import { routes } from '../../config/routes';

interface Props {
	profession: Profession;
}

const { profession } = Astro.props;
---

<article class="card card-link">
	<span class="tag">ia aplicada · desde cero</span>
	<h3><a href={routes.profession(profession.id)}>{profession.data.name}</a></h3>
	<p>{profession.data.summary}</p>
	<p class="weeks">{profession.data.weeks.length} semanas</p>
</article>

<style>
	.card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 12px;
		height: 100%;
		padding: 24px;
	}

	.tag {
		padding: 2px 10px;
		border-radius: 999px;
		background: var(--pop);
		color: var(--on-pop);
		font: 12px var(--mono);
	}

	h3 {
		font-size: 26px;
		line-height: 1.15;
		letter-spacing: -0.02em;
	}

	p {
		flex: 1;
		color: var(--ink-2);
		font-size: 16px;
	}

	.weeks {
		flex: none;
		width: 100%;
		padding-top: 12px;
		border-top: 1px dashed var(--line);
		font: 13px var(--mono);
		color: var(--muted);
	}
</style>
