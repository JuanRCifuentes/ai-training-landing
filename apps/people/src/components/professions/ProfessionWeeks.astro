---
import type { Profession } from '../../data/professions';

interface Props {
	weeks: Profession['data']['weeks'];
}

const { weeks } = Astro.props;
---

<ol class="weeks">
	{
		weeks.map((week, index) => (
			<li>
				<p class="kicker">semana {index + 1}</p>
				<h3>{week.title}</h3>
				<p>{week.goal}</p>
				<p class="outcome">
					<span>te llevas:</span> {week.outcome}
				</p>
			</li>
		))
	}
</ol>

<style>
	.weeks {
		display: grid;
		grid-template-columns: 1fr;
		gap: 16px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 900px) {
		.weeks {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	li {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 24px;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
	}

	h3 {
		font-size: 22px;
		line-height: 1.2;
		letter-spacing: -0.01em;
	}

	p {
		color: var(--ink-2);
		font-size: 16px;
	}

	.outcome {
		margin-top: auto;
		padding-top: 12px;
		border-top: 1px dashed var(--line);
		font: 13px var(--mono);
	}

	.outcome span {
		color: var(--accent);
	}
</style>
