---
import type { Course } from '../../data/types';
import { routes } from '../../config/routes';

interface Props {
	course: Course;
}

const { course } = Astro.props;
---

<article class="course card-link" aria-labelledby={`course-${course.ref}`}>
	<div class="meta">
		<span class="ref">{course.ref}</span>
		<span class:list={['level', { highlight: course.level === 'avanzado' }]}>{course.level}</span>
	</div>
	<h3 id={`course-${course.ref}`}><a href={routes.course(course.slug)}>{course.title}</a></h3>
	<p>{course.summary}</p>
	<p class="outcome"><b>construyes:</b> {course.outcome}</p>
</article>

<style>
	.course {
		display: flex;
		flex-direction: column;
		gap: 12px;
		height: 100%;
		padding: 24px;
	}

	.meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-family: var(--mono);
	}

	.ref {
		color: var(--muted);
		font-size: 13px;
	}

	.level {
		padding: 2px 10px;
		border-radius: 999px;
		background: var(--accent-soft);
		color: var(--accent);
		font-size: 12px;
	}

	.level.highlight {
		background: var(--pop);
		color: var(--on-pop);
	}

	h3 {
		font-size: 22px;
		line-height: 1.2;
		letter-spacing: -0.01em;
	}

	p {
		color: var(--ink-2);
		font-size: 16px;
	}

	.outcome {
		margin-top: auto;
		padding-top: 12px;
		border-top: 1px dashed var(--line);
		font: 13px var(--mono);
	}

	.outcome b {
		color: var(--accent);
		font-weight: 500;
	}
</style>
