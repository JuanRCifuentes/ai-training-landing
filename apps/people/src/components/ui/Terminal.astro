---
import type { TerminalLine } from '../../data/types';

interface Props {
	lines: TerminalLine[];
	/** File name shown in the window bar. */
	filename: string;
	/** Describes the content for assistive technology; the window itself is decorative. */
	label: string;
}

const { lines, filename, label } = Astro.props;
---

<figure class="terminal" role="img" aria-label={label}>
	<div class="bar" aria-hidden="true">
		<span></span><span></span><span></span>
		<b>{filename}</b>
	</div>
	<div class="body">
		{
			lines.map((line) => (
				<span class="line">
					{line.map((token) => (
						<span class={token.kind ?? 'text'}>{token.text}</span>
					))}
				</span>
			))
		}
	</div>
</figure>

<style>
	.terminal {
		min-width: 0;
		margin: 0;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--terminal);
		color: var(--terminal-ink);
		font: 14px/1.6 var(--mono);
		box-shadow: 0 30px 60px -30px rgb(40 20 120 / 45%);
	}

	.bar {
		display: flex;
		gap: 7px;
		padding: 12px 16px;
		border-bottom: 1px solid #22222a;
	}

	.bar span {
		width: 11px;
		height: 11px;
		border-radius: 50%;
		background: #33333d;
	}

	.bar b {
		margin-left: auto;
		color: var(--terminal-dim);
		font-size: 12px;
		font-weight: 400;
	}

	.body {
		padding: 18px 20px 22px;
	}

	.line {
		display: block;
		min-height: 1.6em;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}

	.prompt {
		color: var(--pop);
	}

	.comment {
		color: var(--terminal-dim);
	}

	.key {
		color: var(--terminal-key);
	}

	.caret {
		display: inline-block;
		width: 8px;
		height: 1.1em;
		vertical-align: -3px;
		background: var(--pop);
		animation: blink 1s steps(1) infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
</style>
