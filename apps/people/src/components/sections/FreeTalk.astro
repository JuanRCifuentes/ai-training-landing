---
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import { waitlistCta } from '../../config/site';
import { freeTalkFacts } from '../../data/content';
---

<Section id="free-talk" aria-labelledby="free-talk-title">
	<div class="card">
		<div>
			<h2 id="free-talk-title">Empieza gratis: charla abierta de 90 minutos</h2>
			<p>
				Un recorrido en vivo por todo lo que puedes hacer con IA en tu trabajo, con demos y preguntas. Si te gusta, ya
				sabes qué curso tomar.
			</p>
		</div>
		<div class="aside">
			<ul>
				{freeTalkFacts.map((fact) => <li>{fact}</li>)}
			</ul>
			<Button href={waitlistCta.href} variant="inverse">Avísame de la próxima fecha</Button>
		</div>
	</div>
</Section>

<style>
	.card {
		display: grid;
		grid-template-columns: 1fr;
		gap: 28px;
		align-items: center;
		padding: 48px 28px;
		border-radius: var(--radius-lg);
		background: var(--accent);
		color: var(--on-accent);
	}

	@media (min-width: 900px) {
		.card {
			grid-template-columns: 1.4fr 1fr;
			padding: 56px;
		}
	}

	h2 {
		font-size: clamp(30px, 4vw, 48px);
		font-weight: 700;
		line-height: 1.05;
	}

	p {
		max-width: 48ch;
		margin-top: 14px;
		font-size: 18px;
		opacity: 0.92;
	}

	.aside {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 22px;
	}

	ul {
		display: flex;
		flex-direction: column;
		gap: 10px;
		margin: 0;
		padding: 0;
		list-style: none;
		font: 14px var(--mono);
	}

	li::before {
		content: '→ ';
	}
</style>
