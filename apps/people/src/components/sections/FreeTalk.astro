---
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import AccentPanel from '../ui/AccentPanel.astro';
import { waitlistCta } from '../../config/site';
import { freeTalkFacts } from '../../data/content';
---

<Section id="free-talk" aria-labelledby="free-talk-title">
	<AccentPanel>
		<h2 id="free-talk-title">Empieza gratis: charla abierta de 90 minutos</h2>
		<p>
			Un recorrido en vivo por todo lo que puedes hacer con IA en tu trabajo, con demos y preguntas. Si te gusta, ya
			sabes qué curso tomar.
		</p>
		<Fragment slot="action">
			<ul>
				{freeTalkFacts.map((fact) => <li>{fact}</li>)}
			</ul>
			<Button href={waitlistCta.href} variant="inverse">Avísame de la próxima fecha</Button>
		</Fragment>
	</AccentPanel>
</Section>

<style>
	ul {
		display: flex;
		flex-direction: column;
		gap: 10px;
		margin: 0;
		padding: 0;
		list-style: none;
		font: 14px var(--mono);
	}

	li::before {
		content: '→ ';
	}
</style>
