---
import type { Profession } from '../../data/professions';
import { routes } from '../../config/routes';

interface Props {
	profession: Profession;
}

const { profession } = Astro.props;
---

<article class="card">
	<p class="eyebrow">IA aplicada</p>
	<h3><a href={routes.profession(profession.id)}>{profession.data.name}</a></h3>
	<p class="summary">{profession.data.summary}</p>
	<p class="weeks">{profession.data.weeks.length} semanas · desde cero</p>
</article>

<style>
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 10px;
		height: 100%;
		padding: 22px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius);
	}

	.eyebrow {
		color: var(--accent);
	}

	h3 {
		font-family: var(--serif);
		font-size: 26px;
		font-weight: 400;
	}

	/* The title link covers the whole card, so the card is one click target with one accessible name. */
	h3 a {
		color: inherit;
		text-decoration: none;
	}

	h3 a::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.card:hover {
		border-color: var(--accent);
	}

	.card:hover h3 a {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.card:has(a:focus-visible) {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	h3 a:focus-visible {
		outline: none;
	}

	.summary {
		flex: 1;
		color: var(--ink-2);
		font-size: 15px;
	}

	.weeks {
		padding-top: 12px;
		border-top: 1px solid var(--line);
		font-family: var(--mono);
		font-size: 13px;
		color: var(--muted);
	}
</style>
