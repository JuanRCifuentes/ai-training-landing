---
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import ModuleCard from '../modules/ModuleCard.astro';
import { introSession, moduleLabel, modules } from '../../data/modules';

interface Props {
	index: string;
}

const { index } = Astro.props;
---

<Section id="modules" band aria-labelledby="modules-title">
	<SectionHeader index={index} label="Módulos" title="Catálogo del programa" id="modules-title">
		<p class="body-text">
			La sesión inicial es común a toda la organización. Los módulos pueden cursarse por separado o como parte de una
			ruta.
		</p>
	</SectionHeader>
	<ul class="card-grid">
		<li class="featured">
			<ModuleCard module={introSession} featured eyebrow={moduleLabel(introSession)} />
		</li>
		{
			modules.map((module) => (
				<li>
					<ModuleCard module={module} />
				</li>
			))
		}
	</ul>
</Section>

<style>
	.featured {
		grid-column: 1 / -1;
	}
</style>
