---
import Breadcrumbs from './Breadcrumbs.astro';
import type { ComponentProps } from 'astro/types';

interface Props extends ComponentProps<typeof Breadcrumbs> {
	eyebrow: string;
	title: string;
}

const { eyebrow, title, trail, current } = Astro.props;
---

<header class="page-header">
	<div class="container">
		<Breadcrumbs trail={trail} current={current} />
		<p class="eyebrow">{eyebrow}</p>
		<h1>{title}</h1>
		{Astro.slots.has('default') && <p class="lead"><slot /></p>}
	</div>
</header>

<style>
	.page-header {
		padding: 40px 0 64px;
		border-bottom: 1px solid var(--line);
	}

	.eyebrow {
		margin-top: 48px;
		color: var(--accent);
	}

	h1 {
		max-width: 22ch;
		margin: 16px 0 20px;
		font-size: clamp(34px, 4.6vw, 56px);
		line-height: 1.08;
	}
</style>
