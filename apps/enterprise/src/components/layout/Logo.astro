---
import { site } from '../../config/site';
import { routes } from '../../config/routes';
import { markLetters } from '../../config/brand';
---

<a class="logo" href={routes.home}>
	<svg class="mark" viewBox="0 0 48 48" aria-hidden="true">
		<path fill="currentColor" d={markLetters}></path>
		<path d="M6 36.5H42" stroke="currentColor" stroke-width="1.5"></path>
		<path d="M6 40H42" stroke="currentColor" stroke-width="0.75"></path>
	</svg>
	<span class="words">
		<span class="name">{site.name}</span>
		<span class="subtitle">Formación para organizaciones</span>
	</span>
</a>

<style>
	.logo {
		display: flex;
		align-items: center;
		gap: 12px;
		color: var(--ink);
		text-decoration: none;
		line-height: 1.15;
	}

	.mark {
		flex: none;
		width: 40px;
		height: 40px;
		color: var(--accent);
	}

	.words {
		display: flex;
		flex-direction: column;
	}

	.name {
		font-family: var(--serif);
		font-weight: 500;
		font-size: 18px;
	}

	.subtitle {
		font-size: 11px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
	}
</style>
