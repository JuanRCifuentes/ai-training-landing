---
interface Props {
	/** Section number shown in the label, e.g. "01". */
	index: string;
	label: string;
	title: string;
	/** Id of the heading, referenced by the section's aria-labelledby. */
	id: string;
}

const { index, label, title, id } = Astro.props;
---

<div class="section-header">
	<p class="label eyebrow"><span class="index">{index}</span><span>{label}</span></p>
	<div class="stack">
		<h2 id={id}>{title}</h2>
		<slot />
	</div>
</div>

<style>
	.section-header {
		display: grid;
		grid-template-columns: 1fr;
		gap: 20px;
		margin-bottom: 56px;
	}

	@media (min-width: 900px) {
		.section-header {
			grid-template-columns: 4fr 8fr;
			gap: 40px;
		}

		.label {
			padding-top: 12px;
		}
	}

	.label {
		display: flex;
		gap: 14px;
		align-items: baseline;
	}

	.index {
		color: var(--accent);
	}

	.stack {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	h2 {
		font-size: clamp(28px, 3.4vw, 42px);
		line-height: 1.15;
		max-width: 22ch;
	}
</style>
