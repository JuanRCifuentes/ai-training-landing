---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Hero from '../components/sections/Hero.astro';
import ModuleCatalog from '../components/sections/ModuleCatalog.astro';
import RolePaths from '../components/sections/RolePaths.astro';
import Professions from '../components/sections/Professions.astro';
import Methodology from '../components/sections/Methodology.astro';
import Measurement from '../components/sections/Measurement.astro';
import ResponsibleUse from '../components/sections/ResponsibleUse.astro';
import Principles from '../components/sections/Principles.astro';
import Faq from '../components/sections/Faq.astro';
import OpenCourses from '../components/sections/OpenCourses.astro';
import Contact from '../components/sections/Contact.astro';
import { homeStructuredData } from '../data/structuredData';

// Section order drives the numbering shown in each section label.
const sections = [
	ModuleCatalog,
	RolePaths,
	Professions,
	Methodology,
	Measurement,
	ResponsibleUse,
	Principles,
	Faq,
	OpenCourses,
	Contact,
];
const indexOf = (position: number) => String(position + 1).padStart(2, '0');
---

<BaseLayout>
	<JsonLd slot="head" data={homeStructuredData(Astro.site)} />
	<Hero />
	{sections.map((Section, position) => <Section index={indexOf(position)} />)}
</BaseLayout>
